# Copie para .env e preencha. O .env é ignorado pelo Git.
# Lido pelo Python (settings.py) e pelo docker compose (docker-compose.yml).

# Conexão usada pelo ETL e pela API (DB_USER vazio = autenticação do Windows)
DB_SERVER=localhost,1433
DB_NAME=remuneracao_tce
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# Porta publicada pelo container do docker compose (mantenha igual à de DB_SERVER)
# A senha precisa seguir a política do SQL Server: 8+ caracteres com 3 de: maiúscula, minúscula, número, símbolo.
DB_PORT=1433
